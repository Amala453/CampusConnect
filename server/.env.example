# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/campusconnect
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect
# Optional server selection timeout in milliseconds (default: 30000)
# MONGODB_TIMEOUT_MS=30000

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
# Development: http://localhost:5173
# Production (Netlify Frontend): https://<your-site-name>.netlify.app
CLIENT_URL=http://localhost:5173

# Optional Initial Admin Seed Credentials
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campusconnect.edu
ADMIN_PASSWORD=AdminSecure123!
